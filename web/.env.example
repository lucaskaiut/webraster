# Em dev (local), deixe vazio para usar o proxy do Vite
# VITE_API_BASE_URL=

# Em produção, defina a URL absoluta da API:
# VITE_API_BASE_URL=https://api.example.com

VITE_APP_NAME="Web Raster"

# Google Maps (Monitoramento)
VITE_GOOGLE_MAPS_API_KEY=

# Reverb (WebSocket em tempo real)
# Em produção use o host público do Reverb, ex.: wss://ws.example.com (porta 443, scheme https)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
