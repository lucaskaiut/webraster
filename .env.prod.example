# Produção — VPS nuvemax
# Copie este arquivo para .env.prod no servidor e preencha os valores reais.
# As chaves de aplicação (APP_KEY, REVERB_*, CONTRACT_EVIDENCE_*, BUILD_TOKEN)
# devem ser copiadas do .env de produção atual para que a migração de dados
# (dump/restore) continue funcionando sem re-chaves.

# ---------------------------------------------------------------------------
# Variáveis de infraestrutura (substituição no docker-compose.prod.yml)
# ---------------------------------------------------------------------------
API_DOMAIN=new-webraster-api.nuvemax.srv.br
WS_DOMAIN=new-webraster-ws.nuvemax.srv.br

MYSQL_ROOT_PASSWORD=troque-me
DB_PASSWORD=troque-me

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
APP_NAME="Web Raster"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://new-webraster-api.nuvemax.srv.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=webraster
DB_USERNAME=webraster
DB_PASSWORD=troque-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.nuvemax.srv.br
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

FRONTEND_URL=https://webraster.nuvemax.srv.br
SANCTUM_STATEFUL_DOMAINS=new-webraster.nuvemax.srv.br,webraster.nuvemax.srv.br
CORS_ALLOWED_ORIGINS=https://new-webraster.nuvemax.srv.br,https://webraster.nuvemax.srv.br

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CHAT_QUEUE=chat

# Reverb (WebSocket). REVERB_HOST interno = serviço "reverb" da stack.
REVERB_APP_ID=webraster
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@noxtecnologias.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Billing / Asaas
BILLING_DAYS_BEFORE_DUE=3
BILLING_PAYMENT_WINDOW_DAYS=3
BILLING_RECURRING_CHARGE_MAX_ATTEMPTS=3
BILLING_RECURRING_CHARGE_RETRY_DELAY_MS=500
BILLING_RECURRING_REMOTE_IP=127.0.0.1
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_USER_AGENT=WebRaster/1.0
ASAAS_TIMEOUT=30
ASAAS_CREDIT_CARD_TIMEOUT=60

# Assistente de IA
ASSISTANT_ENABLED=false
ASSISTANT_ENDPOINT=https://api.openai.com/v1
ASSISTANT_API_KEY=
ASSISTANT_MODEL=gpt-4o-mini
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_MAX_TOKENS=
ASSISTANT_AGENT=
ASSISTANT_HISTORY_LIMIT=40
ASSISTANT_MAX_TOOL_ITERATIONS=6

# CRM / Chat (Evolution API)
EVOLUTION_API_BASE_URL=https://evolution.lucaskaiut.com.br
EVOLUTION_API_KEY=
CHAT_MESSAGING_PROVIDERS=evolution

# Traccar
TRACCAR_ENABLED=true
TRACCAR_BASE_URL=http://traccar:8082
TRACCAR_SERVER_IP=185.194.219.192
TRACCAR_SERVER_DNS=dispositivos.nuvemax.srv.br
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
TRACCAR_TOKEN=
TRACCAR_TIMEOUT=15
TRACCAR_WEBHOOK_SECRET=

# Banco do gateway Traccar (usado só pela limpeza de tc_positions; vazio = etapa pulada)
TRACCAR_DB_HOST=mysql
TRACCAR_DB_PORT=3306
TRACCAR_DB_DATABASE=traccar
TRACCAR_DB_USERNAME=traccar
TRACCAR_DB_PASSWORD=

# Retenção/limpeza agendada (comando tracking:prune).
# gps_positions, alerts e device_command_logs NUNCA são limpos (relatórios ≥ 6 meses).
PRUNE_TRACCAR_EVENTS_DAYS=30
PRUNE_EQUIPMENT_RAW_LOGS_DAYS=30
PRUNE_TRACCAR_POSITIONS_DAYS=60

# Google Maps Platform (autocomplete de endereço e rotas de agendamento)
# Use uma chave de servidor com Places API (New) e Routes API habilitadas.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_LANGUAGE=pt-BR
GOOGLE_MAPS_TIMEOUT=8
# google = Routes API com TRAFFIC_UNAWARE (ignora trânsito); osrm = alternativa
ROUTING_PROVIDER=google

# Push (Expo)
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts

# Evidências de assinatura de contratos
CONTRACT_EVIDENCE_KEY_ID=
CONTRACT_EVIDENCE_PRIVATE_KEY=
CONTRACT_EVIDENCE_PRIVATE_KEY_PATH=
CONTRACT_EVIDENCE_TRUSTED_KEYS=
CONTRACT_SIGNING_SESSION_TTL=30
CONTRACT_VERIFICATION_URL=https://webraster.nuvemax.srv.br/validar-contrato
CONTRACT_ALLOW_LEGACY_SIGNING=true

# Proxies confiáveis (subnet da rede nuvemax_edge)
TRUSTED_PROXIES=172.31.0.0/24

# Build do aplicativo (sincronização de marcas dos tenants)
BUILD_TOKEN=
