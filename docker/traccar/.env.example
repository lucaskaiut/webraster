# Traccar — configuração da stack na VPS nuvemax.

# URL pública da interface (usada nos links gerados pelo Traccar).
WEB_URL=https://new-dispositivos.nuvemax.srv.br

# Host roteado pelo Traefik (deve resolver para a VPS nuvemax).
TRACCAR_DOMAIN=new-dispositivos.nuvemax.srv.br

# Senha do usuário "traccar" no MySQL compartilhado (base traccar).
DATABASE_PASSWORD=troque-me

# Segredo do webhook de posições — o MESMO valor de TRACCAR_WEBHOOK_SECRET no .env.prod do painel.
TRACCAR_WEBHOOK_SECRET=troque-me

# URL do webhook do painel (rede interna; alternativa: https://new-webraster-api.nuvemax.srv.br/api/webhooks/traccar).
FORWARD_URL=http://webraster-app/api/webhooks/traccar

# Imagem local com o decoder EasyTrack corrigido (transferida do contabo).
TRACCAR_IMAGE=local/traccar:6.15.3-easytrack-cc
